# JALDRISHTI Environment Variable Configuration Template
# DO NOT put real passwords or secret keys in this file!
# Copy this file to .env locally and fill in your actual credentials.

# MongoDB Atlas Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=jaldrishti

# Application Security
SECRET_KEY=your_secure_random_secret_key_change_in_production
ENVIRONMENT=development

# Optional AI / Weather Services
GEMINI_API_KEY=

# Firebase Authentication
     VITE_FIREBASE_API_KEY=...
     VITE_FIREBASE_AUTH_DOMAIN=...
     VITE_FIREBASE_PROJECT_ID=...
     VITE_FIREBASE_STORAGE_BUCKET=...
     VITE_FIREBASE_MESSAGING_SENDER_ID=...
     VITE_FIREBASE_APP_ID=...
